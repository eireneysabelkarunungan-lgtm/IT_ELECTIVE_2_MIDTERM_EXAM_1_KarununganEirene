@model IEnumerable<ServiceJobListItemDto>
@{
    ViewData["Title"] = "Service Monitoring";
    var searchTerm = ViewData["SearchTerm"] as string;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="page-kicker">VeHI-cle &middot; Dashboard</div>
        <h3 class="page-heading mb-0">Service Monitoring</h3>
    </div>
    <a asp-controller="ServiceJob" asp-action="Create" class="btn btn-primary">
        Register Vehicle
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-controller="ServiceJob" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-auto flex-grow-1">
                <input type="text" name="searchTerm" value="@searchTerm" class="form-control"
                       placeholder="Search by Service Number, Customer Name, Plate Number, or Vehicle..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Search</button>
                @if (!string.IsNullOrWhiteSpace(searchTerm))
                {
                    <a asp-controller="ServiceJob" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="table-responsive p-3">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Service #</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Plate #</th>
                <th>Service Type</th>
                <th>Bay</th>
                <th>Check-in</th>
                <th>Release</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="10" class="text-center text-muted py-4">No service jobs found.</td>
            </tr>
        }
        else
        {
            @foreach (var job in Model)
            {
                <tr>
                    <td><strong>@job.ServiceNumber</strong></td>
                    <td>@job.CustomerName</td>
                    <td>@job.Vehicle</td>
                    <td>@job.PlateNumber</td>
                    <td>@job.ServiceType</td>
                    <td>@job.ServiceBay</td>
                    <td>@job.CheckInDateTime.ToString("MM/dd/yyyy h:mm tt")</td>
                    <td>@(job.ActualReleaseDateTime.HasValue ? job.ActualReleaseDateTime.Value.ToString("MM/dd/yyyy h:mm tt") : "-")</td>
                    <td><span class="@StatusBadgeHelper.CssClass(job.Status)">@StatusBadgeHelper.DisplayName(job.Status)</span></td>
                    <td class="text-end">
                        <a asp-controller="ServiceJob" asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-controller="ServiceJob" asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        @if (job.Status != ServiceStatus.Released)
                        {
                            <a asp-controller="ServiceJob" asp-action="Release" asp-route-id="@job.Id" class="btn btn-sm btn-outline-success">Release</a>
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
