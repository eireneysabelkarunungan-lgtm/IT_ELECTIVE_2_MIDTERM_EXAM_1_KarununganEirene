@model ServiceJobReleaseDto
@{
    ViewData["Title"] = "Release Vehicle";
}

<h3 class="mb-3">Release Vehicle</h3>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <dl class="row">
            <dt class="col-sm-3">Service Number</dt>
            <dd class="col-sm-9">@Model.ServiceNumber</dd>
            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>
            <dt class="col-sm-3">Vehicle</dt>
            <dd class="col-sm-9">@Model.Vehicle</dd>
            <dt class="col-sm-3">Plate Number</dt>
            <dd class="col-sm-9">@Model.PlateNumber</dd>
        </dl>

        <hr />

        <form asp-controller="ServiceJob" asp-action="Release" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ServiceNumber" />
            <input type="hidden" asp-for="CustomerName" />
            <input type="hidden" asp-for="Vehicle" />
            <input type="hidden" asp-for="PlateNumber" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ActualReleaseDateTime" class="form-label"></label>
                <input asp-for="ActualReleaseDateTime" class="form-control" />
                <span asp-validation-for="ActualReleaseDateTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Remarks" class="form-label"></label>
                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Remarks" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Confirm Release</button>
            <a asp-controller="ServiceJob" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
