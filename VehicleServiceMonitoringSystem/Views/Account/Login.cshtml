@model LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="card auth-card">
    <div class="card-body">
        <div class="page-kicker">VeHI-cle &middot; Account Access</div>
        <h2 class="page-heading">Sign in</h2>
        <p class="page-subtitle">Please sign in to your account to continue.</p>

        <form asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" placeholder="e.g. jdelacruz" autofocus />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign in</button>

            <p class="text-center mt-4 mb-0" style="color: var(--color-muted); font-size: 0.9rem;">
                Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}