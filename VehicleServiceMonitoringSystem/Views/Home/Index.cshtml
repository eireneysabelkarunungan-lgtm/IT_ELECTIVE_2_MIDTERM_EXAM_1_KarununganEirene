@{
    ViewData["Title"] = "Welcome";
}

<div class="hero-card p-5 mb-4">
    <div class="container-fluid py-3">
        <div class="page-kicker">VeHI-cle &middot; Front Desk</div>
        <h1 class="page-heading display-6">Vehicle Service Monitoring System</h1>
        <p class="page-subtitle col-md-8 fs-6">
            Track customer vehicles from check-in to release. Register vehicles, monitor
            active service jobs across every bay, and keep an accurate record of when each
            vehicle came in and went out.
        </p>
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Login">Login</a>
        <a class="btn btn-outline-secondary btn-lg" asp-controller="Account" asp-action="Register">Create an Account</a>
    </div>
</div>